{
  "descripcion": "F4 · Mobile táctil: HOME abierto, lámina de links, scroller interno en pantalla baja.",
  "steps": [
    { "viewport": { "width": 390, "height": 844, "mobile": true, "scale": 2 } },
    { "nav": "http://localhost:5173/" },
    { "wait": 4500 },
    { "eval": "(() => { const root=document.querySelector('[data-mode]'); const v=document.querySelector('video'); window.__st=()=>[root.dataset.mode, root.dataset.active, root.dataset.texts ?? '-', location.hash, v.paused ? 'pausa' : 'play']; return __st() })()", "expect": ["closed", "0", "-", "", "pausa"] },
    { "swipe": { "x": 200, "fromY": 420, "toY": 420, "steps": 1 } },
    { "wait": 2300 },
    { "eval": "(() => { const s=document.querySelector('[data-open-panel=home] [data-stage-scroller]'); return [__st(), document.documentElement.scrollWidth, s.scrollHeight <= s.clientHeight] })()", "label": "14 tap → HOME abierto; entra en 390×844 sin scroll", "expect": [["open", "0", "0", "#home", "play"], 390, true] },
    { "shot": "../shots/f4-m-home.png" },
    { "swipe": { "x": 228, "fromY": 38, "toY": 38, "steps": 1 } },
    { "wait": 600 },
    { "shot": "../shots/f4-m-lamina.png" },
    { "eval": "([...document.querySelectorAll('#navbar-mobile-sheet button')].find(x => x.textContent.includes('Preguntas')).click(), 1)" },
    { "wait": 2900 },
    { "eval": "[__st(), getComputedStyle(document.getElementById('navbar-mobile-sheet')).display]", "label": "15 lámina → PREGUNTAS y la lámina se cierra", "expect": [["open", "4", "4", "#preguntas", "pausa"], "none"] },
    { "shot": "../shots/f4-m-preguntas.png" },
    { "swipe": { "x": 200, "fromY": 650, "toY": 350, "steps": 8 } },
    { "wait": 2800 },
    { "eval": "__st()", "label": "16 swipe → CONTACTO", "expect": ["open", "5", "5", "#contacto", "pausa"] },
    { "viewport": { "width": 390, "height": 600, "mobile": true, "scale": 2 } },
    { "nav": "about:blank" },
    { "nav": "http://localhost:5173/#home" },
    { "wait": 2500 },
    { "eval": "(() => { const r=document.querySelector('[data-mode]'); window.__s=document.querySelector('[data-open-panel=home] [data-stage-scroller]'); window.__ab=()=>[r.dataset.mode, r.dataset.active]; return [__ab(), __s.scrollHeight > __s.clientHeight] })()", "label": "17 HOME en 390×600 es más alto que la pantalla", "expect": [["open", "0"], true] },
    { "swipe": { "x": 200, "fromY": 500, "toY": 200, "steps": 8 } },
    { "wait": 2800 },
    { "eval": "[__ab(), __s.scrollTop > 0]", "label": "18 1.er swipe: scrollea el panel, no pasa de panel", "expect": [["open", "0"], true] },
    { "swipe": { "x": 200, "fromY": 500, "toY": 200, "steps": 8 } },
    { "wait": 2800 },
    { "eval": "__ab()", "label": "19 en el borde: el swipe siguiente pasa de panel", "expect": ["open", "1"] }
  ]
}
